{
  "manifest_version": 3,
  "name": "Knowledge Vault Clipper",
  "version": "0.1.0",
  "description": "Clip selected text into a Knowledge Vault 01-收件箱 folder (local, no cloud).",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "contextMenus", "storage"],
  "host_permissions": [],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Clip to Knowledge Vault",
    "default_popup": "pages/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "pages/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ]
}
