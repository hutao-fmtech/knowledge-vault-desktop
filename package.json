{
  "name": "knowledge-vault-desktop-monorepo",
  "version": "0.2.2",
  "private": true,
  "description": "Workspace root (pnpm). The app lives in apps/desktop; capabilities in packages/*.",
  "license": "MIT",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "pnpm --filter knowledge-vault-desktop start",
    "test": "pnpm -r test",
    "check-boundaries": "node scripts/check-boundaries.mjs",
    "smoke": "node scripts/smoke-create.js && node scripts/smoke-agent-write.js && node scripts/smoke-advanced.js",
    "smoke:create": "node scripts/smoke-create.js",
    "smoke:agent": "node scripts/smoke-agent-write.js",
    "smoke:advanced": "node scripts/smoke-advanced.js",
    "pack:desktop": "pnpm --filter knowledge-vault-desktop run pack",
    "dist": "pnpm --filter knowledge-vault-desktop dist",
    "dist:win": "pnpm --filter knowledge-vault-desktop dist:win",
    "dist:mac": "pnpm --filter knowledge-vault-desktop dist:mac",
    "dist:linux": "pnpm --filter knowledge-vault-desktop dist:linux",
    "build:desktop": "node scripts/build-desktop.mjs"
  },
  "devDependencies": {
    "acorn": "8.15.0",
    "electron-builder": "^25.1.8",
    "js-yaml": "4.3.2"
  }
}
