{
  "name": "@kvd/advanced",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "description": "Advanced mode: controller, IPC origin gate, tool-call log, host, and the approval-bridge / audit-log / vault-tools Cordis plugins.",
  "license": "MIT",
  "exports": {
    "./controller": {
      "types": "./lib/controller.d.ts",
      "default": "./lib/controller.js"
    },
    "./origin": {
      "types": "./lib/origin.d.ts",
      "default": "./lib/origin.js"
    },
    "./tool-log": {
      "types": "./lib/tool-log.d.ts",
      "default": "./lib/tool-log.js"
    },
    "./run-result": {
      "types": "./lib/run-result.d.ts",
      "default": "./lib/run-result.js"
    },
    "./host": {
      "types": "./lib/host.d.ts",
      "default": "./lib/host.js"
    },
    "./approval-bridge": {
      "types": "./lib/approval-bridge.d.ts",
      "default": "./lib/approval-bridge.js"
    },
    "./audit-log": {
      "types": "./lib/audit-log.d.ts",
      "default": "./lib/audit-log.js"
    },
    "./vault-tools": {
      "types": "./lib/vault-tools.d.ts",
      "default": "./lib/vault-tools.js"
    },
    "./bash-sandbox": {
      "types": "./lib/bash-sandbox.d.ts",
      "default": "./lib/bash-sandbox.js"
    },
    "./git-bash": {
      "types": "./lib/git-bash.d.ts",
      "default": "./lib/git-bash.js"
    }
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "lib/**/*.d.ts.map"
  ],
  "scripts": {
    "test": "vitest run"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-bash-sandbox": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-sandbox": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/dsh-user-approval": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "3.18.4",
    "@kvd/shared": "workspace:*"
  },
  "devDependencies": {
    "vitest": "4.1.8"
  }
}
