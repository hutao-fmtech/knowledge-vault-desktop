{
  "name": "@kvd/shared",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "description": "Shared constants: model routes, app config dir, WeChat OA vault paths.",
  "license": "MIT",
  "exports": {
    "./models": {
      "types": "./lib/models.d.ts",
      "default": "./lib/models.js"
    },
    "./config-dir": {
      "types": "./lib/config-dir.d.ts",
      "default": "./lib/config-dir.js"
    },
    "./wechat-oa": {
      "types": "./lib/wechat-oa.d.ts",
      "default": "./lib/wechat-oa.js"
    }
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "lib/**/*.d.ts.map"
  ],
  "scripts": {
    "test": "vitest run"
  },
  "devDependencies": {
    "vitest": "4.1.8"
  }
}
