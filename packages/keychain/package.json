{
  "name": "@kvd/keychain",
  "version": "0.2.2",
  "private": true,
  "type": "module",
  "description": "kvd-keychain: credentials provider backed by Electron safeStorage; key never enters process.env.",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "lib/**/*.d.ts.map"
  ],
  "scripts": {
    "test": "vitest run"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-credentials": "0.2.0-rc.2",
    "@kvd/shared": "workspace:*"
  },
  "peerDependencies": {
    "electron": "39.8.10"
  },
  "peerDependenciesMeta": {
    "electron": {
      "optional": true
    }
  },
  "devDependencies": {
    "vitest": "4.1.8"
  }
}
